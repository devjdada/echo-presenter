{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoPresenter",
  "version": "0.1.0",
  "identifier": "com.echopresenter.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EchoPresenter",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/echo-renderer"],
    "resources": ["../../../resources/bible-modules/bundled_public_domain.sqlite"]
  }
}
